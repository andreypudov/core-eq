    "Strong low bass and forward upper mids, for club music." : {
      "comment" : "Built-in preset description: Dance",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرار قوي ووسط علوي متقدّم، لموسيقى النوادي."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вӑйлӑ пас тата малта тӑракан ҫӳлти варри: клуб музыки валли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves potentes y medios-agudos al frente, para música de club."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des graves forts et un haut-médium en avant, pour la musique de club."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強い低音と前に出た中高域。クラブミュージックに。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有力的低頻佮較前的中高頻，適合夜店音樂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мощный низ и выдвинутая верхняя середина — для клубной музыки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强劲的低频和靠前的中高频，适合俱乐部音乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強勁的低頻與靠前的中高頻，適合夜店音樂。"
          }
        }
      }
    },
    "System Audio Not Allowed" : {
      "comment" : "Menu bar extra row: CoreEQ couldn’t capture system audio",
      "localizations" : {
        "ar" : {
