    "%@ has exclusive access to “%@”, so its sound isn’t being equalized. The equalizer returns when %@ lets go." : {
      "comment" : "Engine status: an app holds an output device to itself",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدى %1$@ وصول حصري إلى «%2$@»، لذا لا تتم معادلة صوته. يعود معادل الصوت عندما يحرّره %3$@."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ «%2$@» хатӗре хӑйне ҫеҫ йышӑннӑ, ҫавӑнпа унӑн сасси эквалайзер урлӑ иртмест. %3$@ хатӗре ирӗке янӑ хыҫҫӑн эквалайзер каялла ӗҫлеме тытӑнать."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has exclusive access to “%2$@”, so its sound isn’t being equalized. The equalizer returns when %3$@ lets go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene acceso exclusivo a “%2$@”, así que su sonido no se ecualiza. El ecualizador vuelve cuando %3$@ lo libere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a un accès exclusif à « %2$@ », son son n’est donc pas égalisé. L’égaliseur reprend dès que %3$@ le libère."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が「%2$@」を排他的に使用しているため、そのサウンドはイコライズされていません。%3$@が解放するとイコライザが戻ります。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 咧獨佔使用「%2$@」，所以伊的聲音無經過等化。%3$@ 放掉了後，等化器就會轉來。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %1$@ монопольный доступ к «%2$@», поэтому его звук не эквализуется. Эквалайзер вернётся, когда %3$@ освободит устройство."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在独占使用“%2$@”，因此其声音未经均衡。%3$@ 释放后，均衡器即会恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在獨占使用「%2$@」，因此其聲音未經等化。%3$@ 釋放後，等化器就會恢復。"
          }
        }
      }
    },
