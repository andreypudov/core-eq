        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 最多可容納 %lld 個參數頻段"
          }
        }
      }
    },
    "CoreEQ isn’t allowed to reach the sound" : {
      "comment" : "Permission heading, after the permission was refused",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ غير مسموح له بالوصول إلى الصوت"
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ-а сасса ҫитме ирӗк паман"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ no tiene permiso para llegar al sonido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ n’est pas autorisé à accéder au son"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQはサウンドへのアクセスを許可されていません"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 無予准接觸聲音"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ не разрешён доступ к звуку"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 未获准接触声音"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 未獲准接觸聲音"
          }
        }
      }
    },
    "CoreEQ isn’t receiving any audio, so it’s leaving your sound alone instead of replacing it." : {
      "comment" : "Engine failure: sound is playing but none reaches CoreEQ",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستقبل CoreEQ أي صوت، لذا يترك صوتك كما هو بدلًا من استبداله."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ нимӗнле аудио та илмест, ҫавӑнпа сасса улӑштармасть, ӑна ылмаштармасть."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ no recibe audio, así que deja tu sonido como está en lugar de sustituirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ ne reçoit aucun audio : il laisse donc votre son tel quel au lieu de le remplacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQにオーディオが届いていないため、サウンドを置き換えずにそのままにしています。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 攏無收著音訊，所以予聲音維持原狀，無共換掉。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ не получает звук, поэтому оставляет его без изменений, а не подменяет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 没有收到任何音频，因此保持声音不变，而不是替换它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 沒有收到任何音訊，因此讓聲音維持原狀，而不是取代它。"
          }
        }
      }
    },
    "CoreEQ isn’t receiving any audio, so it’s leaving your sound alone instead of replacing it. This is what a refused permission looks like." : {
      "comment" : "Engine failure, when the permission seems to be refused",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستقبل CoreEQ أي صوت، لذا يترك صوتك كما هو بدلًا من استبداله. هكذا يبدو الإذن المرفوض."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ нимӗнле аудио та илмест, ҫавӑнпа сасса улӑштармасть, ӑна ылмаштармасть. Ирӗк паман чух ҫапла пулать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ no recibe audio, así que deja tu sonido como está en lugar de sustituirlo. Así es como se ve un permiso denegado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ ne reçoit aucun audio : il laisse donc votre son tel quel au lieu de le remplacer. C’est ce qui se passe quand l’autorisation a été refusée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQにオーディオが届いていないため、サウンドを置き換えずにそのままにしています。許可が拒否されたときはこうなります。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 攏無收著音訊，所以予聲音維持原狀，無共換掉。權限予人拒絕的時就會按呢。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ не получает звук, поэтому оставляет его без изменений, а не подменяет. Так выглядит отказ в разрешении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 没有收到任何音频，因此保持声音不变，而不是替换它。权限被拒绝时就会如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 沒有收到任何音訊，因此讓聲音維持原狀，而不是取代它。權限遭拒時就會如此。"
          }
        }
      }
    },
