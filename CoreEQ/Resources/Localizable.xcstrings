    "%@ hertz" : {

    },
    "%@ of %@" : {
      "comment" : "AutoEq catalog download progress, such as “2 MB of 5 MB”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ · %lld filters · Preamp %@" : {
      "comment" : "Import sheet heading: preset name, filter count, and output trim",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %#@filters@ · Preamp %3$@"
          },
          "substitutions" : {
            "filters" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg filter"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg filters"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
