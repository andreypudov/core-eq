    "Compute the trim from the chain, so a boosted preset stays at the loudness it started from" : {
      "comment" : "Automatic gain help tag, while off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب الضبط من السلسلة، ليبقى الإعداد المسبق المعزّز بارتفاع الصوت الذي بدأ به"
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
