    "Big, round low bass, a recessed lower midrange, and smooth highs." : {
      "comment" : "Built-in preset description: R&B",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرار كبير ومستدير، ووسط سفلي متراجع، وحاد ناعم."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пысӑк, ҫаврака пас, каялла тӑракан аялти варри тата ҫемҫе ҫӳлли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves grandes y redondos, medios-graves retirados y agudos suaves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des graves amples et ronds, un bas-médium en retrait et des aigus doux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きく丸い低音、引っ込めた中低域、なめらかな高域。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大閣圓的低頻、退後的中低頻佮滑順的高頻。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большой круглый низ, утопленная нижняя середина и мягкие верха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "饱满圆润的低频、后退的中低频和平滑的高频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飽滿圓潤的低頻、後退的中低頻與平滑的高頻。"
          }
        }
      }
    },
