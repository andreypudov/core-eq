    "Point at a handle to read its value; drag it to adjust; double-click to reset it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أشِر إلى مقبض لقراءة قيمته، واسحبه لضبطه، وانقر مرتين لإعادة تعيينه"
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паллӑ ҫине тӗллесе пӗлтерӗшне вулӑр; куҫарса улӑштарӑр; икӗ хут пусса пӑрахӑр"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Señala un tirador para leer su valor; arrástralo para ajustarlo; haz doble clic para restablecerlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez une poignée pour lire sa valeur ; faites-la glisser pour l’ajuster ; double-cliquez pour la réinitialiser"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハンドルにポインタを合わせると値が表示されます。ドラッグで調整、ダブルクリックでリセット"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共指標囥佇控制點頂懸讀數值；拖來調整；揤兩下重設"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите на маркер, чтобы увидеть значение; перетащите, чтобы изменить; двойной щелчок — сброс"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
