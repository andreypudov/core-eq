    "Leaving apps out needs macOS 26 or later. On this Mac, CoreEQ equalizes every app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب استبعاد التطبيقات macOS 26 أو أحدث. على هذا الـ Mac، يعادل CoreEQ كل التطبيقات."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложенисене кӑларса пӑрахма macOS 26 е ҫӗнӗрех кирлӗ. Ку Mac-ра CoreEQ пур приложенисене те эквалайзер урлӑ ярать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir apps requiere macOS 26 o posterior. En este Mac, CoreEQ ecualiza todas las apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclure des apps nécessite macOS 26 ou ultérieur. Sur ce Mac, CoreEQ égalise toutes les apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの除外にはmacOS 26以降が必要です。このMacでは、CoreEQはすべてのアプリをイコライズします。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排除 App 愛 macOS 26 抑是較新的版本。佇這台 Mac，CoreEQ 會共所有的 App 攏等化。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключение приложений требует macOS 26 или новее. На этом Mac CoreEQ эквализует все приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排除 App 需要 macOS 26 或更高版本。在这台 Mac 上，CoreEQ 会均衡所有 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排除 App 需要 macOS 26 或以上版本。在這部 Mac 上，CoreEQ 會等化所有 App。"
          }
        }
      }
    },
    "Less weight below 500 Hz, for boomy rooms or bass-heavy headphones." : {
      "comment" : "Built-in preset description: Bass Reducer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وزن أقل تحت ⁦500 Hz⁩، للغرف ذات الطنين أو السماعات كثيفة الجهير."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "500 Hz-ран аяларах йывӑрлӑх сахалрах: кӗрлекен пӳлӗмсем е пас нумай наушниксем валли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos peso por debajo de 500 Hz, para salas retumbantes o auriculares con muchos graves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de poids sous 500 Hz, pour les pièces qui résonnent ou les casques riches en basses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "500 Hz以下を軽くします。響きすぎる部屋や低音の強いヘッドフォンに。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "500 Hz 以下較輕，適合會嗡嗡叫的房間抑是低音傷重的耳機。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньше веса ниже 500 Гц — для гулких комнат и басовитых наушников."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减少 500 Hz 以下的分量，适合有轰鸣感的房间或低音偏重的耳机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "減少 500 Hz 以下的分量，適合有轟隆感的房間或低音偏重的耳機。"
          }
        }
      }
    },
