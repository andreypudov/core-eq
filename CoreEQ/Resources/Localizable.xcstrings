    "A band boosts or cuts one frequency, on top of the Graphic sliders. Add one below, or double-click the graph where you want it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرفع النطاق ترددًا واحدًا أو يخفضه، إضافةً إلى منزلقات الوضع الرسومي. أضف نطاقًا بالأسفل، أو انقر مرتين على الرسم البياني حيث تريده."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полоса пӗр частотӑна хӑпартать е антарать, графика шуҫӑмӗсем ҫумне. Аялта хушӑр е графикӑн кирлӗ вырӑнне икӗ хут пусӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una banda realza o atenúa una frecuencia, además de los reguladores del modo Gráfico. Añade una abajo o haz doble clic en el gráfico donde la quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bande accentue ou atténue une fréquence, en plus des curseurs du mode Graphique. Ajoutez-en une ci-dessous, ou double-cliquez sur le graphique à l’endroit voulu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンドは、グラフィックのスライダとは別に1つの周波数をブーストまたはカットします。下で追加するか、グラフ上の置きたい位置をダブルクリックしてください。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頻段會當佇圖形推桿以外，共某一个頻率提懸抑是降低。佇下跤加入，抑是佇圖表欲囥的所在揤兩下。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полоса поднимает или опускает одну частоту поверх графических ползунков. Добавьте её ниже или дважды щёлкните по графику в нужном месте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "频段可在图形推子之外提升或衰减某一频率。可在下方添加，或在图表上想要的位置连按两次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頻段可在圖形推桿之外增強或衰減某個頻率。可在下方加入，或在圖表上想要的位置按兩下。"
          }
        }
      }
    },
    "A gentle lift at both ends and a slightly recessed midrange, for orchestral and chamber music." : {
      "comment" : "Built-in preset description: Classical",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفع لطيف عند الطرفين ووسط متراجع قليلًا، للموسيقى الأوركسترالية وموسيقى الحجرة."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Икӗ вӗҫӗнче ҫӑмӑллӑн ҫӗкленӗ, варри кӑшт каялла: оркестр тата камера музыки валли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ligero realce en ambos extremos y unos medios algo retirados, para música orquestal y de cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux extrémités légèrement relevées et un médium un peu en retrait, pour la musique orchestrale et de chambre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両端をゆるやかに持ち上げ、中域をわずかに引っ込めます。オーケストラや室内楽に。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩頭輕輕仔提懸、中頻小可退後，適合管弦樂佮室內樂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкий подъём по краям и немного утопленная середина — для оркестровой и камерной музыки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两端轻微提升、中频略微后退，适合管弦乐与室内乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩端輕微提升、中頻略微後退，適合管弦樂與室內樂。"
          }
        }
      }
    },
    "A heavy low end with slightly pulled-back mids and a little air on top." : {
      "comment" : "Built-in preset description: Hip-Hop",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرار ثقيل ووسط متراجع قليلًا ولمسة من الهواء في الأعلى."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вӑйлӑ пас, кӑшт каялла тӑракан варри тата ҫӳлте кӑшт уҫлӑх."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves contundentes, medios ligeramente retirados y un poco de aire arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des graves puissants, un médium légèrement en retrait et un peu d’air dans les aigus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重い低域、わずかに引っ込めた中域、高域にほんの少しの空気感。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚實的低頻、小可退後的中頻，頂懸閣加一點仔空氣感。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мощный низ, слегка отодвинутая середина и немного воздуха наверху."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚重的低频、略微后退的中频，高频再添一点空气感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚重的低頻、略微後退的中頻，高頻再添一點空氣感。"
          }
        }
      }
    },
    "A softened bottom and a warm midrange, for relaxed background listening." : {
      "comment" : "Built-in preset description: Lounge",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرار ناعم ووسط دافئ، للاستماع الهادئ في الخلفية."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҫемҫетнӗ пас тата ӑшӑ варри: лӑпкӑ фонлӑ итлев валли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves suavizados y unos medios cálidos, para escuchar relajado de fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bas adouci et un médium chaleureux, pour une écoute détendue en fond."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やわらげた低域と温かみのある中域。くつろいだBGMに。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔軟的低頻佮燒烙的中頻，適合輕鬆的背景聽。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смягчённый низ и тёплая середина — для спокойного фонового прослушивания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔和的低频与温暖的中频，适合轻松的背景聆听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔和的低頻與溫暖的中頻，適合輕鬆的背景聆聽。"
          }
        }
      }
    },
