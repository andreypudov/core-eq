    "Two copies would each silence the other’s sound, so only one can run." : {
      "comment" : "Alert message: why two copies of CoreEQ can’t run together",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستكتم كل نسخة صوت الأخرى، لذا لا يمكن تشغيل سوى نسخة واحدة."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Икӗ копи пӗр-пӗрин сассине путарӗҫ, ҫавӑнпа пӗрре ҫеҫ ӗҫлеме пултарать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos copias silenciarían cada una el sonido de la otra, así que solo puede haber una abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux copies couperaient chacune le son de l’autre : une seule peut être ouverte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つのコピーは互いのサウンドを消してしまうため、1つしか実行できません。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩份會互相共對方的聲音恬去，所以干焦會當開一份。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Две копии глушили бы звук друг друга, поэтому может работать только одна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个副本会互相使对方的声音静音，因此只能运行一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩份會互相讓對方的聲音靜音，因此只能執行一份。"
          }
        }
      }
    },
    "Two versions of this preset; switch between them to compare" : {
