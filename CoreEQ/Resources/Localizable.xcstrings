    "Fuller low end and a brighter, more present top, for acoustic guitar and unplugged recordings." : {
      "comment" : "Built-in preset description: Acoustic",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرار أكمل وحاد أكثر إشراقًا وحضورًا، للغيتار الصوتي والتسجيلات غير الموصولة."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тулли пас тата ҫутӑ, илемлӗ ҫӳлли: акустика гитари тата unplugged ҫырӑвсем валли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves más llenos y agudos más brillantes y presentes, para guitarra acústica y grabaciones unplugged."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bas plus plein et un haut plus brillant et présent, pour la guitare acoustique et les enregistrements unplugged."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚みのある低域と、明るく存在感のある高域。アコースティックギターやアンプラグド録音に。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較飽滇的低頻佮較光、較有臨場感的高頻，適合木吉他佮無插電錄音。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более полный низ и яркий, присутствующий верх — для акустической гитары и записей unplugged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更饱满的低频和更明亮、更有临场感的高频，适合原声吉他和不插电录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更飽滿的低頻與更明亮、更有臨場感的高頻，適合原聲吉他與不插電錄音。"
          }
        }
      }
    },
