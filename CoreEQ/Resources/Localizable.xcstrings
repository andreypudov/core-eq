    "The CoreEQ preset is damaged and can’t be read." : {
      "comment" : "Import error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعداد المسبق لـ CoreEQ تالف ولا يمكن قراءته."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ пресечӗ сиенленнӗ, ӑна вулама ҫук."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El preajuste de CoreEQ está dañado y no se puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le préréglage CoreEQ est endommagé et ne peut pas être lu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQのプリセットが破損しているため読み込めません。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 預設歹去矣，讀袂出來。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пресет CoreEQ повреждён и не читается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 预置已损坏，无法读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 預設組已損毀，無法讀取。"
          }
        }
      }
    },
    "The audio device CoreEQ built around “%@” reported no output channels, so there’s nowhere to send the equalized sound." : {
      "comment" : "Engine failure: the output device has no channels",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُبلِغ جهاز الصوت الذي أنشأه CoreEQ حول «%@» عن أي قنوات خرج، لذا لا مكان لإرسال الصوت المعادَل إليه."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ «%@» тавра тунӑ аудио хатӗрӗ пӗр кӑлару каналне те пӗлтермерӗ, ҫавӑнпа эквалайзер урлӑ иртнӗ сасса ӑҫта ярасси ҫук."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo de audio que CoreEQ creó en torno a “%@” no indica canales de salida, así que el sonido ecualizado no tiene adónde ir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le périphérique audio que CoreEQ a créé autour de « %@ » n’a signalé aucun canal de sortie : le son égalisé n’a nulle part où aller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQが「%@」をもとに作成したオーディオデバイスが出力チャンネルを報告しなかったため、イコライズしたサウンドの送り先がありません。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 圍「%@」起的音訊裝置，攏無報輸出聲道，等化了的聲音無所在通送。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудиоустройство, созданное CoreEQ вокруг «%@», не сообщило ни одного выходного канала — эквализованному звуку некуда идти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 围绕“%@”创建的音频设备未报告任何输出声道，均衡后的声音无处可送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 圍繞「%@」建立的音訊裝置未回報任何輸出聲道，等化後的聲音無處可送。"
          }
        }
      }
    },
