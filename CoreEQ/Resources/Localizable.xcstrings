    "Output trim applied after the whole chain; use it to give back the headroom a boosted preset takes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضبط الخرج المطبّق بعد السلسلة كلها؛ استخدمه لاستعادة الهامش الذي يأخذه الإعداد المسبق المعزّز"
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пӗтӗм рет хыҫҫӑнхи кӑлару шайӗ; ҫӗкленӗ пресет илекен запаса каялла тавӑрма усӑ курӑр"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste de salida aplicado tras toda la cadena; úsalo para devolver el margen que consume un preajuste realzado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustement de sortie appliqué après toute la chaîne ; utilisez-le pour rendre la marge qu’un préréglage accentué consomme"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェーン全体の後に適用される出力トリム。ブーストしたプリセットが使うヘッドルームを取り戻すのに使います"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "佇規个處理鏈了後用的輸出調整；用伊共提懸型預設佔去的空間補轉來"
