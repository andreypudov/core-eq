    "Equalizes everything you hear, with no driver and nothing left behind." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعادل كل ما تسمعه، دون برنامج تشغيل ودون ترك أي أثر."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эсир илтекен пур сасса та эквалайзер урлӑ ярать, драйверсӗр, йӗр хӑвармасӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecualiza todo lo que oyes, sin controlador y sin dejar rastro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Égalise tout ce que vous entendez, sans pilote et sans laisser de trace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聞こえるすべてをイコライズ。ドライバ不要、何も残しません。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你聽著的一切攏等化，免驅動程式，嘛袂留痕跡。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эквализует всё, что вы слышите, — без драйвера и без следов в системе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均衡你听到的一切，无需驱动，不留痕迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等化你聽到的一切，不需驅動程式，不留痕跡。"
          }
        }
      }
    },
    "Equalizing the sound on “%@”." : {
      "comment" : "Engine status: the output device being equalized",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
