    },
    "Everything above 1 kHz softened, for harsh or sibilant recordings." : {
      "comment" : "Built-in preset description: Treble Reducer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنعيم كل ما فوق ⁦1 kHz⁩، للتسجيلات الحادة أو كثيرة الصفير."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz-ран ҫӳлерехи пӗтӗмпех ҫемҫетнӗ: хытӑ е шӑхӑракан ҫырӑвсем валли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que está por encima de 1 kHz, suavizado, para grabaciones ásperas o sibilantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui dépasse 1 kHz adouci, pour les enregistrements durs ou sifflants."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz以上をすべてやわらげます。きつい、または歯擦音の多い録音に。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz 以上攏放軟，適合刺耳抑是齒音重的錄音。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё выше 1 кГц смягчено — для резких или шипящих записей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔化 1 kHz 以上的一切，适合刺耳或齿音重的录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔化 1 kHz 以上的一切，適合刺耳或齒音明顯的錄音。"
          }
        }
      }
    },
    "Exclude %@" : {
      "localizations" : {
        "ar" : {
