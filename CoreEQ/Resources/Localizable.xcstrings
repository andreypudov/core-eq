    "The system audio arrived in a format CoreEQ can’t equalize: it needs 32-bit floating-point samples." : {
      "comment" : "Engine failure: the audio tap delivered an unsupported sample format",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل صوت النظام بتنسيق لا يستطيع CoreEQ معادلته: فهو يحتاج إلى عيّنات فاصلة عائمة بدقة 32 بت."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тытӑм сасси CoreEQ эквалайзер урлӑ яраймасан форматпа килчӗ: ӑна 32 битлӑ шуҫакан пусӑллӑ тӗслӗхсем кирлӗ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio del sistema llegó en un formato que CoreEQ no puede ecualizar: necesita muestras de coma flotante de 32 bits."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio système est arrivé dans un format que CoreEQ ne peut pas égaliser : il lui faut des échantillons en virgule flottante 32 bits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQがイコライズできない形式でシステムオーディオが届きました。32ビット浮動小数点のサンプルが必要です。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統音訊的格式 CoreEQ 等化袂來：伊需要 32 位元浮點取樣。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системный звук пришёл в формате, который CoreEQ не может эквализовать: нужны 32-битные отсчёты с плавающей точкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统音频的格式是 CoreEQ 无法均衡的：它需要 32 位浮点采样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統音訊的格式是 CoreEQ 無法等化的：它需要 32 位元浮點取樣。"
          }
        }
      }
    },
    "The trim is computed from the chain; turn this off to set it by hand" : {
      "comment" : "Automatic gain help tag, while on",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
