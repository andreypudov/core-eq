    "Drag or scroll to set; double-click the knob to return to 0 dB" : {
      "comment" : "Gain knob help tag",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب أو مرّر للضبط، وانقر مرتين على المقبض للعودة إلى ⁦0 dB⁩"
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҫавӑрса е кустарса ӗнерлӗр; 0 dB таврӑнма ручка ҫине икӗ хут пусӑр"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra o desplaza para ajustar; haz doble clic en el mando para volver a 0 dB"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser ou défiler pour régler ; double-cliquez sur le bouton pour revenir à 0 dB"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグまたはスクロールで設定。ノブをダブルクリックすると0 dBに戻ります"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖抑是捲來設定；揤兩下旋鈕轉去 0 dB"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите или прокрутите для настройки; двойной щелчок по ручке вернёт 0 дБ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移或滚动进行设定；连按两次旋钮可恢复为 0 dB"
          }
