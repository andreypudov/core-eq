    "CoreEQ couldn’t capture system audio (error %d). Make sure CoreEQ is turned on in System Settings > Privacy & Security > Screen & System Audio Recording." : {
      "comment" : "Engine failure: the audio tap couldn’t be created; the number is its error code",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على CoreEQ التقاط صوت النظام (الخطأ %d). تأكد من تشغيل CoreEQ في إعدادات النظام > الخصوصية والأمن > تسجيل الشاشة وصوت النظام."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ тытӑм сассине тытаймарӗ (йӑнӑш %d). Тытӑм ӗнерлевӗсем > Вӑрттӑнлӑх тата хӳтлӗх > Экранпа тытӑм сассине ҫырни ҫинче CoreEQ ҫутнине тӗрӗслӗр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ no ha podido capturar el audio del sistema (error %d). Asegúrate de que CoreEQ está activado en Ajustes del Sistema > Privacidad y seguridad > Grabación de pantalla y audio del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ n’a pas pu capturer l’audio système (erreur %d). Assurez-vous que CoreEQ est activé dans Réglages Système > Confidentialité et sécurité > Enregistrement de l’écran et de l’audio système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQはシステムオーディオを取り込めませんでした（エラー%d）。“システム設定”>“プライバシーとセキュリティ”>“画面収録とシステムオーディオ録音”でCoreEQがオンになっていることを確認してください。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 擷取袂著系統音訊（錯誤 %d）。請確定佇「系統設定」>「隱私權佮安全性」>「螢幕佮系統錄音」內底有拍開 CoreEQ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ не смог захватить системный звук (ошибка %d). Убедитесь, что CoreEQ включён в Системных настройках > Конфиденциальность и безопасность > Запись экрана и системного звука."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 无法捕获系统音频（错误 %d）。请确保在“系统设置”>“隐私与安全性”>“录屏与系统录音”中打开了 CoreEQ。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 無法擷取系統音訊（錯誤 %d）。請確定已在「系統設定」>「隱私權與安全性」>「螢幕與系統錄音」中開啟 CoreEQ。"
          }
        }
      }
    },
    "CoreEQ couldn’t change its login item. Open System Settings > General > Login Items to change it there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على CoreEQ تغيير عنصر تسجيل الدخول الخاص به. افتح إعدادات النظام > عام > عناصر تسجيل الدخول لتغييره هناك."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ кӗнӗ чух уҫӑлассине улӑштараймарӗ. Тытӑм ӗнерлевӗсем > Тӗп > Кӗнӗ чухнехи объектсем уҫса унта улӑштарӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ no ha podido cambiar su ítem de inicio. Abre Ajustes del Sistema > General > Ítems de inicio para cambiarlo allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ n’a pas pu modifier son ouverture à la connexion. Ouvrez Réglages Système > Général > Ouverture à la connexion pour la modifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQはログイン項目を変更できませんでした。“システム設定”>“一般”>“ログイン項目”を開いて変更してください。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 改袂著伊的登入項目。請拍開「系統設定」>「一般」>「登入項目」佇遐改。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ не смог изменить объект входа. Откройте Системные настройки > Основные > Объекты входа и измените его там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 无法更改其登录项。请打开“系统设置”>“通用”>“登录项”进行更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 無法更改其登入項目。請打開「系統設定」>「一般」>「登入項目」進行更改。"
          }
        }
      }
    },
    "CoreEQ couldn’t download AutoEq data (HTTP %lld). Try again." : {
      "comment" : "AutoEq error: the number is the HTTP status code",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على CoreEQ تنزيل بيانات AutoEq ‏(⁦HTTP %lld⁩). حاول مرة أخرى."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ AutoEq даннӑйӗсене илсе ҫитерейменрӗ (HTTP %lld). Тепӗр хут хӑтланӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ no ha podido descargar datos de AutoEq (HTTP %lld). Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ n’a pas pu télécharger les données AutoEq (HTTP %lld). Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQはAutoEqのデータをダウンロードできませんでした（HTTP %lld）。もう一度お試しください。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 下載袂著 AutoEq 資料（HTTP %lld）。請閣試一擺。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ не смог загрузить данные AutoEq (HTTP %lld). Попробуйте ещё раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 无法下载 AutoEq 数据（HTTP %lld）。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 無法下載 AutoEq 資料（HTTP %lld）。請再試一次。"
          }
        }
      }
    },
    "CoreEQ couldn’t download AutoEq data from GitHub. Check your internet connection and try again." : {
      "comment" : "AutoEq error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على CoreEQ تنزيل بيانات AutoEq من GitHub. تحقق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ GitHub-ран AutoEq даннӑйӗсене илсе ҫитерейменрӗ. Интернет ҫыхӑнӑвне тӗрӗслӗр те тепӗр хут хӑтланӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ no ha podido descargar datos de AutoEq desde GitHub. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ n’a pas pu télécharger les données AutoEq depuis GitHub. Vérifiez votre connexion à Internet et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQはGitHubからAutoEqのデータをダウンロードできませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 對 GitHub 下載袂著 AutoEq 資料。請檢查網路連線，閣試一擺。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ не смог загрузить данные AutoEq с GitHub. Проверьте подключение к интернету и попробуйте ещё раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 无法从 GitHub 下载 AutoEq 数据。请检查互联网连接并重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 無法從 GitHub 下載 AutoEq 資料。請檢查網際網路連線後再試一次。"
          }
        }
      }
    },
    "CoreEQ couldn’t identify its own audio output, so it can’t leave itself out of what it captures. It’s leaving your sound alone and will try again." : {
      "comment" : "Engine failure: CoreEQ couldn’t find its own audio process",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على CoreEQ تحديد خرج الصوت الخاص به، لذا لا يمكنه استبعاد نفسه مما يلتقطه. سيترك صوتك كما هو وسيحاول مرة أخرى."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ хӑйӗн аудио кӑларӑвне палӑртаймарӗ, ҫавӑнпа хӑйне тытакан сасӑран кӑларса пӑраймасть. Вӑл сасса улӑштармасть, каярахпа тепӗр хут хӑтланӗ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ no ha podido identificar su propia salida de audio, así que no puede excluirse de lo que captura. Deja tu sonido como está y volverá a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ n’a pas pu identifier sa propre sortie audio, et ne peut donc pas s’exclure de ce qu’il capture. Il laisse votre son tel quel et réessaiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQは自身のオーディオ出力を特定できなかったため、取り込み対象から自分を除外できません。サウンドはそのままにして、もう一度試します。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 認袂出家己的音訊輸出，所以無法度共家己排除佇擷取範圍以外。伊會予聲音維持原狀，等一下閣試。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ не смог определить собственный аудиовыход, поэтому не может исключить себя из захвата. Он оставляет звук без изменений и попробует снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 无法识别自己的音频输出，因此无法将自己排除在捕获范围之外。它会保持声音不变，并稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ 無法識別自己的音訊輸出，因此無法將自己排除在擷取範圍之外。它會讓聲音維持原狀，並稍後再試。"
          }
        }
      }
    },
    "CoreEQ couldn’t set up the audio path (error %d)." : {
      "comment" : "Engine failure: a Core Audio call failed; the number is its error code",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على CoreEQ إعداد مسار الصوت (الخطأ %d)."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoreEQ аудио ҫулне йӗркелеймерӗ (йӑнӑш %d)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
