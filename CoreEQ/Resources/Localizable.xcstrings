    "Browsers can’t be excluded: they play through a helper process that macOS shares between apps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استبعاد المتصفحات: فهي تُشغّل الصوت عبر عملية مساعدة يتشاركها macOS بين التطبيقات."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузерсене кӑларса пӑрахма ҫук: вӗсем macOS приложенисем хушшинче пайлакан пулӑшу процесӗ урлӑ янӑраҫҫӗ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los navegadores no se pueden excluir: reproducen a través de un proceso auxiliar que macOS comparte entre apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les navigateurs ne peuvent pas être exclus : ils lisent le son via un processus auxiliaire que macOS partage entre les apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザは除外できません。macOSがアプリ間で共有するヘルパープロセスを通して再生するためです。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽器袂當排除：瀏覽器是透過 macOS 予 App 公家用的輔助程序咧播聲音。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузеры исключить нельзя: они играют через вспомогательный процесс, общий для нескольких приложений macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法排除浏览器：浏览器通过 macOS 在 App 之间共享的辅助进程播放声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法排除瀏覽器：瀏覽器透過 macOS 在 App 之間共用的輔助程序播放聲音。"
          }
        }
      }
    },
    "Built-In" : {
      "localizations" : {
        "ar" : {
