    "Bass and treble up, mids back, so percussion and brass come forward." : {
      "comment" : "Built-in preset description: Latin",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفع الجهير والحاد وتراجع الوسط، لتتقدّم الإيقاعات والنحاسيات."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пас тата ҫӳлли ҫӗкленнӗ, варри каялла: перкусси тата пӑхӑр инструменчӗсем малалла тухаҫҫӗ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves y agudos arriba y medios atrás, para que percusión y metales pasen al frente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves et aigus relevés, médium en retrait, pour mettre en avant percussions et cuivres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低音と高音を上げ、中域を下げて、パーカッションと金管を前に出します。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低音佮高音提懸、中頻退後，予拍擊樂佮銅管較出頭。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Низы и верха подняты, середина отодвинута — чтобы ударные и духовые вышли вперёд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低音和高音提升、中频后退，让打击乐与铜管更突出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低音與高音提升、中頻後退，讓打擊樂與銅管更突出。"
          }
        }
      }
    },
