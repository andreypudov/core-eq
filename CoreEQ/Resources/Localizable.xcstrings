    "Midrange forward, bass and treble lighter, so vocals lead." : {
      "comment" : "Built-in preset description: Pop",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوسط إلى الأمام، والجهير والحاد أخف، ليقود الصوت البشري."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варри малта, пасӗпе ҫӳлли ҫӑмӑлрах: сасӑ ертсе пытӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medios al frente, graves y agudos más ligeros, para que mande la voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Médium en avant, graves et aigus allégés, pour que la voix mène."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中域を前に出し、低音と高音を軽くして、ボーカルを主役に。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中頻較前、低音佮高音較輕，予人聲行頭前。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Середина вперёд, низы и верха легче — чтобы вёл голос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中频靠前、低音与高音较轻，让人声主导。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中頻靠前、低音與高音較輕，讓人聲主導。"
          }
        }
      }
    },
    "More bass and less treble, for laptop and small speakers that sound thin or harsh." : {
      "comment" : "Built-in preset description: Small Speakers",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهير أكثر وحاد أقل، لسماعات الحواسيب المحمولة والسماعات الصغيرة ذات الصوت الرقيق أو الحاد."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пас нумайрах, ҫӳлли сахалрах: ноутбук тата пӗчӗк колонкӑсем валли, вӗсем ҫинҫе е хытӑ янӑрасан."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más graves y menos agudos, para altavoces de portátil y pequeños que suenan delgados o ásperos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de graves et moins d’aigus, pour les haut-parleurs d’ordinateur portable et les petites enceintes au son maigre ou dur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低音を増やし高音を減らします。音が薄い、またはきついノートパソコンや小型スピーカーに。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較濟低音、較少高音，適合聲音薄抑是刺耳的筆電佮細台喇叭。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше баса и меньше верхов — для ноутбучных и маленьких колонок, звучащих тонко или резко."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多低音、更少高音，适合声音单薄或刺耳的笔记本电脑和小型扬声器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多低音、更少高音，適合聲音單薄或刺耳的筆記型電腦與小型揚聲器。"
          }
        }
      }
    },
    "More bass and lower midrange, softer treble: a darker, warmer sound." : {
      "comment" : "Built-in preset description: Deep",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهير أكثر ووسط سفلي أكثر وحاد أنعم: صوت أغمق وأدفأ."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пас тата аялти варри нумайрах, ҫӳлли ҫемҫерех: тӗттӗмрех, ӑшӑрах сасӑ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más graves y medios-graves, agudos más suaves: un sonido más oscuro y cálido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de graves et de bas-médium, des aigus plus doux : un son plus sombre et chaleureux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低音と中低域を増やし、高音をやわらげます。暗く温かいサウンド。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較濟低音佮中低頻，高音較軟：較暗、較燒烙的聲音。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше баса и нижней середины, мягче верха — тёмный, тёплый звук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多低音与中低频，高音更柔和：更深沉、更温暖的声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多低音與中低頻，高音更柔和：更深沉、更溫暖的聲音。"
          }
        }
      }
    },
    "More body and a brighter, more present top, for solo piano." : {
      "comment" : "Built-in preset description: Piano",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جسم أكثر وحاد أكثر إشراقًا وحضورًا، للبيانو المنفرد."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ӳт-пӳ нумайрах, ҫӳлли ҫутӑрах та илемлӗрех: пӗччен фортепиано валли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más cuerpo y agudos más brillantes y presentes, para piano solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de corps et un haut plus brillant et présent, pour le piano solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚みを増し、明るく存在感のある高域。ピアノソロに。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較有份量，高頻較光、較有臨場感，適合鋼琴獨奏。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше тела и яркий, присутствующий верх — для сольного фортепиано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更有分量，高频更明亮、更有临场感，适合钢琴独奏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更有分量，高頻更明亮、更有臨場感，適合鋼琴獨奏。"
          }
        }
      }
    },
    "More brightness above 1 kHz, most around 8 kHz." : {
      "comment" : "Built-in preset description: Treble Booster",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشراق أكثر فوق ⁦1 kHz⁩، وأكثره حول ⁦8 kHz⁩."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz-ран ҫӳлерех ҫутӑлӑх нумайрах, чи нумай 8 kHz таврашӗнче."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más brillo por encima de 1 kHz, sobre todo hacia 8 kHz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de brillance au-dessus de 1 kHz, surtout vers 8 kHz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz以上の明るさを増し、8 kHz付近を最も強く。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz 以上較光，8 kHz 附近上明顯。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше яркости выше 1 кГц, сильнее всего около 8 кГц."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz 以上更明亮，8 kHz 附近最为明显。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz 以上更明亮，8 kHz 附近最為明顯。"
          }
        }
      }
    },
    "More deep bass and high treble, to keep music full at low volume." : {
      "comment" : "Built-in preset description: Loudness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهير عميق وحاد مرتفع أكثر، لتبقى الموسيقى ممتلئة عند مستوى الصوت المنخفض."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарӑн пас тата ҫӳлли нумайрах: шӑппӑн итленӗ чух та музыка тулли янӑратӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más graves profundos y agudos altos, para que la música suene llena a bajo volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de graves profonds et d’aigus, pour garder la musique pleine à faible volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深い低音と高い高音を増やし、小さな音量でも音楽を豊かに保ちます。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較濟深沉低音佮高頻，予音樂細聲聽嘛飽滇。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше глубокого баса и высоких верхов — чтобы музыка звучала полно на малой громкости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多深沉低音和高频，让音乐在低音量下依然饱满。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多深沉低音與高頻，讓音樂在小音量下依然飽滿。"
          }
        }
      }
    },
    "More weight below 250 Hz, held all the way down to 20 Hz. The rest is untouched." : {
      "comment" : "Built-in preset description: Bass Booster",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وزن أكثر تحت ⁦250 Hz⁩، يمتد حتى ⁦20 Hz⁩. يبقى الباقي دون تغيير."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250 Hz-ран аяларах йывӑрлӑх нумайрах, 20 Hz таранах. Ыттисем улшӑнмаҫҫӗ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más peso por debajo de 250 Hz, mantenido hasta 20 Hz. El resto queda igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de poids sous 250 Hz, maintenu jusqu’à 20 Hz. Le reste est inchangé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250 Hz以下の重みを増し、20 Hzまで維持します。それ以外は変えません。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250 Hz 以下較有份量，一直到 20 Hz。其他攏無變。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше веса ниже 250 Гц, вплоть до 20 Гц. Остальное без изменений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250 Hz 以下更有分量，并一直保持到 20 Hz，其余保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250 Hz 以下更有分量，並一路維持到 20 Hz，其餘維持不變。"
          }
        }
      }
    },
