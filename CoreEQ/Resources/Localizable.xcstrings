    "Low bass trimmed and the voice range lifted, so singers and speakers stand out." : {
      "comment" : "Built-in preset description: Vocal Booster",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقليل الجهير العميق ورفع نطاق الصوت البشري، ليبرز المغنّون والمتحدثون."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарӑн паса чакарнӑ, сасӑ диапазонне ҫӗкленӗ: юрӑҫсемпе каласа паракансем уйрӑлса тӑччӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves profundos recortados y registro vocal realzado, para que cantantes y voces destaquen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves profonds réduits et registre vocal relevé, pour faire ressortir chanteurs et voix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低い低音を抑え、声の帯域を持ち上げて、歌手や話し手を際立たせます。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低頻減淡、人聲範圍提懸，予唱歌佮講話的人較出頭。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубокий бас убран, вокальный диапазон поднят — чтобы певцы и дикторы выделялись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削减低频、提升人声范围，让歌手和讲话者更突出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削減低頻、提升人聲範圍，讓歌手與說話者更突出。"
          }
        }
      }
    },
