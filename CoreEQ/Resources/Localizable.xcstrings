    "Deep bass, a dip around 500 Hz, and crisp highs, for synth-driven music." : {
      "comment" : "Built-in preset description: Electronic",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهير عميق، وانخفاض حول ⁦500 Hz⁩، وحاد واضح، للموسيقى القائمة على المُركِّبات."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарӑн пас, 500 Hz таврашӗнче путӑк тата уҫӑмлӑ ҫӳлли: синтезаторлӑ музыка валли."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves profundos, un valle hacia 500 Hz y agudos nítidos, para música basada en sintetizadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des basses profondes, un creux vers 500 Hz et des aigus nets, pour la musique à base de synthétiseurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深い低音、500 Hz付近のくぼみ、くっきりした高域。シンセ中心の音楽に。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深沉的低音、500 Hz 附近凹落去，閣有清脆的高音，適合合成器做主的音樂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубокий бас, провал около 500 Гц и чёткие верха — для синтезаторной музыки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深沉的低音、约 500 Hz 处的凹陷和清脆的高音，适合合成器主导的音乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深沉的低音、約 500 Hz 處的凹陷與清脆的高音，適合合成器主導的音樂。"
          }
        }
