    "“%@” is an aggregate or multi-output device, which CoreEQ can’t equalize. Choose a single output device." : {
      "comment" : "Engine failure: the output device is made of several devices",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» جهاز مجمّع أو متعدد المخارج، ولا يستطيع CoreEQ معادلته. اختر جهاز خرج واحدًا."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — пӗрлештернӗ е нумай кӑларуллӑ хатӗр, CoreEQ ӑна эквалайзер урлӑ яраймасть. Пӗр кӑлару хатӗрне суйлӑр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” es un dispositivo agregado o de salida múltiple, que CoreEQ no puede ecualizar. Elige un único dispositivo de salida."
          }
        },
        "fr" : {
          "stringUnit" : {
