        },
        "zh-Hant" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "儲存時會將 %lld 個數值調整至 CoreEQ 的限制範圍內。"
                }
              }
            }
          }
        }
      }
    },
    "Screen recordings capture both your apps’ sound and CoreEQ’s equalized copy, which sounds doubled. CoreEQ steps aside until the recording stops." : {
      "comment" : "Why CoreEQ pauses while a screen recording captures system audio",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلتقط تسجيلات الشاشة صوت تطبيقاتك ونسخة CoreEQ المعادَلة معًا، فيُسمع الصوت مضاعفًا. يتنحّى CoreEQ حتى يتوقف التسجيل."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран ҫырӑвӗ приложенисен сассине те, CoreEQ эквалайзер урлӑ ярса тунӑ копине те тытать, ҫавӑнпа сасӑ икӗ хутланать. Ҫыру вӗҫленичченех CoreEQ айккинелле пӑрӑнать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones de pantalla capturan el sonido de tus apps y la copia ecualizada de CoreEQ, que suena duplicado. CoreEQ se aparta hasta que termina la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements d’écran capturent à la fois le son de vos apps et la copie égalisée de CoreEQ, ce qui le fait entendre en double. CoreEQ se met en retrait jusqu’à la fin de l’enregistrement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面収録ではアプリのサウンドとCoreEQがイコライズしたコピーの両方が取り込まれ、二重に聞こえます。録画が終わるまでCoreEQは処理を控えます。"
          }
        },
        "nan-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕錄影會同時擷取 App 的聲音佮 CoreEQ 等化了的副本，聽起來就重兩擺。錄了進前 CoreEQ 會先閃開。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись экрана захватывает и звук приложений, и эквализованную копию CoreEQ — звук двоится. CoreEQ отходит в сторону, пока идёт запись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录屏会同时捕获 App 的声音和 CoreEQ 均衡后的副本，听起来像重复了一遍。录制结束前 CoreEQ 会暂时让开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕錄影會同時擷取 App 的聲音與 CoreEQ 等化後的副本，聽起來像重複了一次。錄製結束前 CoreEQ 會暫時讓開。"
          }
        }
      }
    },
