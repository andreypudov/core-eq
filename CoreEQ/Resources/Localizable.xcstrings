    "Punchy low end, bright upper treble, and slightly scooped mids." : {
      "comment" : "Built-in preset description: Rock",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرار قوي، وحاد علوي مشرق، ووسط منخفض قليلًا."
          }
        },
        "cv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вӑйлӑ пас, ҫутӑ ҫӳлли тата кӑшт путӑк варри."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graves contundentes, agudos altos brillantes y medios ligeramente recortados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bas percutant, des hauts aigus brillants et un médium légèrement creusé."
          }
