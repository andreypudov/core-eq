    "NSAudioCaptureUsageDescription" : {
      "comment" : "The reason macOS shows when it asks for the audio permission. Same text as CoreEQ’s own explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An equalizer has to reach the sound to change it. CoreEQ reads audio on its way to your speakers, adjusts it, and plays it straight back. Nothing is recorded, stored, or sent anywhere, and quitting CoreEQ hands the audio back immediately."
          }
        }
      }
    },
